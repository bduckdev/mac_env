#!/opt/homebrew/bin/bash
#
# new-project — pick a category, create a project directory, then run COMMAND
#              with the selection exposed as environment variables.
#
# The command that gets launched is set below in COMMAND. It runs with:
#     TS_DIR    absolute path of the newly created project directory
#     TS_NAME   the project name you entered
#
# Requires: television (tv) — https://github.com/alexpasmantier/television

set -euo pipefail

# --- Config ------------------------------------------------------------------
# Command to launch after the project directory is created.
COMMAND="tmuxifier load-session dev"

# Where each category lives. Edit these to taste.
declare -A BASE_DIRS=(
	[Work]="$HOME/Work"
	[Personal]="$HOME/Personal"
	[School]="$HOME/School"
)
# -----------------------------------------------------------------------------

# Make sure the command and television are available.
if ! command -v "${COMMAND%% *}" >/dev/null 2>&1; then
	echo "Error: command '${COMMAND%% *}' not found on PATH." >&2
	exit 1
fi
if ! command -v tv >/dev/null 2>&1; then
	echo "Error: television (tv) is not installed or not on PATH." >&2
	exit 1
fi

# 1. Select a category with television.
category="$(printf '%s\n' Work Personal School | tv || true)"
if [[ -z "$category" ]]; then
	echo "No category selected. Aborting." >&2
	exit 1
fi

base="${BASE_DIRS[$category]}"

# 2. Ask for the project name.
read -rp "New project name: " selected_name
if [[ -z "${selected_name// /}" ]]; then
	echo "No name given. Aborting." >&2
	exit 1
fi

# 3. Create the directory in the selected location.
selected="$base/$selected_name"
if [[ -e "$selected" ]]; then
	echo "Error: '$selected' already exists." >&2
	exit 1
fi
mkdir -p "$selected"
cp ~/mac_env/AGENTS_TEMPLATE.md "$selected"/AGENTS.md
ln -s "$selected"/AGENTS.md "$selected"/CLAUDE.md
echo "Created $selected"

# 4. Enter the new project and run COMMAND with the selection exported.
cd "$selected"
export TS_DIR="$selected"
export TS_NAME="$selected_name"
echo "Running: TS_DIR=\"$selected\" TS_NAME=\"$selected_name\" $COMMAND"
if [ -n "${TMUX:-}" ]; then
	tmux detach -E "TS_DIR='$selected' TS_NAME='$selected_name' bash -ic '$COMMAND'"
else
	exec $COMMAND
fi
