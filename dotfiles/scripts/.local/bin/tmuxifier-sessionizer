#!/usr/bin/env bash

if [ -n "$TMUX" ]; then
	tmux detach -E "bash -ic tmuxifier-sessionizer"
else
	if [[ $# -eq 1 ]]; then
		selected=$1
	else
		selected=$(
			{
				echo ~/mac_env
				echo ~/Work
				echo ~/Personal
				echo ~/School
				echo ~/Playground
				fd --type d --min-depth 1 --max-depth 1 . \
					~/Work \
					~/Personal \
					~/School \
					~/Playground
			} | fzf
		)
	fi

	[[ -z $selected ]] && exit 0

	if ! tmux has-session -t "$selected" 2>/dev/null; then
		SESSION_DIR="$selected" tmuxifier load-session dev
	else
		tmux switch-client -t "$selected"
	fi
fi
