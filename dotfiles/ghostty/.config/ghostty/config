# font
font-family = JetBrainsMono NFM
font-size = 16
adjust-cell-height = 15%

# cyberdream
foreground = #ffffff
background = #16181a
cursor-color = #ffffff
cursor-text = #16181a
selection-foreground = #ffffff
selection-background = #3c4048
palette = 0=#16181a
palette = 1=#ff6e5e
palette = 2=#5eff6c
palette = 3=#f1ff5e
palette = 4=#5ea1ff
palette = 5=#bd5eff
palette = 6=#5ef1ff
palette = 7=#ffffff
palette = 8=#3c4048
palette = 9=#ff6e5e
palette = 10=#5eff6c
palette = 11=#f1ff5e
palette = 12=#5ea1ff
palette = 13=#bd5eff
palette = 14=#5ef1ff
palette = 15=#ffffff

# window
background-opacity = 0.8
background-blur = 20
macos-titlebar-style = hidden
window-padding-x = 16
window-padding-y = 24,12
confirm-close-surface = false
cursor-style = "block"

# send an explicit Ctrl+Tab sequence for Herdr's last-pane binding
keybind = ctrl+tab=csi:9;5u

# give super number to tmux
keybind = super+1=esc:1
keybind = super+2=esc:2
keybind = super+3=esc:3
keybind = super+4=esc:4
keybind = super+5=esc:5
keybind = super+6=esc:6
keybind = super+7=esc:7
keybind = super+8=esc:8
keybind = super+9=esc:9
