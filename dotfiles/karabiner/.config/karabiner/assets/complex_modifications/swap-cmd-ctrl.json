{
  "title": "Swap Command and Control (except in specified apps)",
  "rules": [
    {
      "description": "Swap Cmd and Ctrl everywhere except in certain apps",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_control" }],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$",
                "^net\\.kovidgoyal\\.kitty$",
                "^com\\.github\\.wez\\.wezterm$",
                "^org\\.gnu\\.Emacs",
                "^com\\.amazon\\.workspaces$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_control",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_command" }],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$",
                "^net\\.kovidgoyal\\.kitty$",
                "^com\\.github\\.wez\\.wezterm$",
                "^org\\.gnu\\.Emacs",
                "^com\\.amazon\\.workspaces$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "right_control" }],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$",
                "^net\\.kovidgoyal\\.kitty$",
                "^com\\.github\\.wez\\.wezterm$",
                "^com\\.amazon\\.workspaces$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_control",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "right_command" }],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$",
                "^net\\.kovidgoyal\\.kitty$",
                "^com\\.github\\.wez\\.wezterm$",
                "^org\\.gnu\\.Emacs",
                "^com\\.amazon\\.workspaces$"
              ]
            }
          ]
        }
      ]
    }
  ]
}
